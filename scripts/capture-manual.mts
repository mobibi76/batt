const audit=process.argv.includes('--audit-help');
const origin=process.env.MANUAL_PREVIEW_ORIGIN||'http://127.0.0.1:4173',root=new URL('../',import.meta.url);
if(new URL(origin).hostname!=='127.0.0.1')throw Error('Manual captures require a local preview.');
const dest=new URL('public/manual/screens/',root),catalogPath=new URL('src/manual/walkthroughs.json',root);
await mkdir(dest,{recursive:true});
const catalog:Record<string,any[]>=JSON.parse(await readFile(catalogPath,'utf8').catch(()=>'{}'));
const browser=await chromium.launch({channel:'chrome',headless:true});let p:Page;
async function fresh(){if(p)await p.context().close();const ctx=await browser.newContext({viewport:{width:1366,height:900},locale:'ko-KR',timezoneId:'Asia/Seoul'});p=await ctx.newPage();p.setDefaultTimeout(10000);await p.route('**/*',r=>new URL(r.request().url()).origin===origin?r.continue():r.abort());}
const button=(name:string)=>p.getByRole('button',{name,exact:true});
async function demo(){await fresh();await p.goto(origin+'/batt/');await button('가상 데이터로 공정 체험').click();await button('예시 셀로 다음 단계').click();await button('생산 홈').click();}
async function save(){await writeFile(catalogPath,JSON.stringify(catalog,null,2)+'\n');}
async function snap(scenario:string,key:string,title:string,items:[Locator,string][],result:string,note='합성 체험 데이터 · 실제 생산·고객 자료 아님'){
 if(audit){await auditHelp(p,`${scenario}/${key}`);return;}
 if(await button('작업 크게 보기').isVisible())await button('작업 크게 보기').click();
 if(await p.locator('.operational-scene').isVisible()){await p.locator('.operational-scene canvas').waitFor();await p.waitForTimeout(300);}
 await p.evaluate(()=>document.fonts.ready);await p.locator('.toast').waitFor({state:'hidden',timeout:4500}).catch(()=>{});
 const marks=[];for(const [loc,text] of items){const e=loc.first();await expect(e).toBeVisible();const b=await e.boundingBox();if(!b||b.y<0||b.y+b.height>900||b.x<0||b.x+b.width>1366)throw Error(`Capture target outside viewport ${scenario}/${key}: ${text} ${JSON.stringify(b)}`);marks.push({...b,text});}
 await p.evaluate(({marks,note})=>{const layer=document.createElement('div');layer.id='manual-capture-overlay';layer.className='manual-capture-overlay';
 const tag=document.createElement('div');tag.textContent=note;tag.className='manual-capture-tag';layer.append(tag);
 const tokens=getComputedStyle(document.documentElement),pad=parseFloat(tokens.getPropertyValue('--space-6')),marker=parseFloat(tokens.getPropertyValue('--space-24')),edge=parseFloat(tokens.getPropertyValue('--space-4'));
 const protectedRects:DOMRect[]=[];const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);while(walker.nextNode()){const node=walker.currentNode;if(!node.textContent?.trim()||!node.parentElement||['SCRIPT','STYLE'].includes(node.parentElement.tagName))continue;const range=document.createRange();range.selectNodeContents(node);for(const rect of range.getClientRects())if(rect.width&&rect.height&&rect.right>0&&rect.left<innerWidth&&rect.bottom>0&&rect.top<innerHeight)protectedRects.push(rect);}for(const el of document.querySelectorAll('input,select,textarea')){const r=el.getBoundingClientRect();if(r.width&&r.height)protectedRects.push(r);}
 marks.forEach((r,i)=>{const box=document.createElement('div');box.className='manual-capture-box';const x=Math.max(edge,r.x-pad),y=Math.max(edge,r.y-pad),right=Math.min(innerWidth-edge,r.x+r.width+pad),bottom=Math.min(innerHeight-edge,r.y+r.height+pad);const candidates=[[right,y],[x-marker,y],[right,y+(bottom-y-marker)/2],[x-marker,y+(bottom-y-marker)/2],[right-marker,y-marker],[x,y-marker],[right-marker,bottom],[x,bottom]].filter(([cx,cy])=>cx>=edge&&cy>=edge&&cx+marker<=innerWidth-edge&&cy+marker<=innerHeight-edge).map(([cx,cy])=>({cx,cy,score:protectedRects.reduce((sum,t)=>sum+Math.max(0,Math.min(cx+marker,t.right)-Math.max(cx,t.left))*Math.max(0,Math.min(cy+marker,t.bottom)-Math.max(cy,t.top)),0)})).sort((a,b)=>a.score-b.score);const position=candidates[0];if(!position||position.score>0)throw Error('No clear annotation position for '+(i+1));for(const [key,value] of Object.entries({'x':x,'y':y,'width':right-x,'height':bottom-y,'marker-x':position.cx-x,'marker-y':position.cy-y}))box.style.setProperty('--capture-'+key,value+'px');
 const n=document.createElement('span');n.textContent=String(i+1);n.className='manual-capture-number';box.append(n);layer.append(box);});document.body.append(layer);},{marks,note});
 const image=`${scenario}-${key}.jpg`;await p.screenshot({path:fileURLToPath(new URL(image,dest)),type:'jpeg',quality:88,animations:'disabled'});await p.locator('#manual-capture-overlay').evaluate(e=>e.remove());
 (catalog[scenario]??=[]).push({image,title,actions:items.map(i=>i[1]),result,note,width:1366,height:900});await save();console.log(`${scenario}/${key}`);
}
